# Публичный адрес сайта. Нужен для canonical, Open Graph, robots.txt и sitemap.xml.
# Укажите реальный домен перед деплоем (без слэша в конце).
NEXT_PUBLIC_SITE_URL=https://example.com

# Куда отправлять заявки с формы. Если не задано — заявка принимается,
# логируется на сервере и дублируется в WhatsApp на стороне клиента.
# Пример для Telegram-бота:
# BOOKING_WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage
# BOOKING_WEBHOOK_CHAT_ID=<CHAT_ID>
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_CHAT_ID=
